#!/usr/bin/env bash
#
# Проверки перед отправкой — то, что раньше делал общий CI организации.
#
# Механика взята из хука, который уже работал в openclaw-dev и cfs-datalake:
# он старше и аккуратнее, повторно изобретать его было бы вредно. Здесь к ней
# добавлено только то, чего требует раскатка на два десятка разных репозиториев:
# область проверок берётся из самого репозитория, а не задаётся жёстко, и
# блокировка включается по согласию репозитория.
#
# Включение — один раз в каждом клоне и в каждом worktree:
#   ./.githooks/install
#
# Обход: git push --no-verify. Это не отказ хука, а отправка, которую никто не
# проверил, и за ней больше нет CI, который заметит.
set -uo pipefail

# git отдаёт хукам GIT_DIR и его родню, указывающие на отправляемый репозиторий.
# Любая проверка, создающая собственный репозиторий — а тесты brain и runtime
# так делают, — начинает молча работать с чужим и падает так, как не падает при
# ручном запуске.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_OBJECT_DIRECTORY
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH GIT_COMMON_DIR

# Имя удалённого репозитория git передаёт первым аргументом. Считать его
# «origin» нельзя: при отправке ветки во второй удалённый репозиторий коммиты,
# уже лежащие в origin, там отсутствуют и остались бы непроверенными.
remote_name=${1:-origin}

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

# Одна отправка может нести несколько ссылок, поэтому диапазоны накапливаются.
# Строка с переводами строк, а не массив: пустой массив под `set -u` опасен на
# том bash 3.2, который до сих пор поставляет macOS.
zero=0000000000000000000000000000000000000000
ranges=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ $local_sha == "$zero" ]] && continue
  if [[ $remote_sha == "$zero" ]]; then
    ranges+="$local_sha --not --remotes=$remote_name"$'\n'
  else
    ranges+="$remote_sha..$local_sha"$'\n'
  fi
done

[[ -z $ranges ]] && exit 0

# Блокируют отправку только те ворота, которые репозиторий назвал в
# .githooks/enforce (строки `lint`, `types`, `tests`). Поиск секретов блокирует
# всегда и в этот список не входит: он единственный останавливает то, что уже
# не отозвать обратно, и был единственной обязательной проверкой общего CI.
enforced() { [[ -f .githooks/enforce ]] && grep -qxE "[[:space:]]*$1[[:space:]]*" .githooks/enforce; }

blocked=""
warned=""

run() {  # run <ворота|-> <название> <команда...>
  local gate=$1 name=$2; shift 2
  local out; out=$(mktemp)
  if "$@" >"$out" 2>&1; then
    printf '  ок     %s\n' "$name"
  else
    if [[ $gate == "-" ]] || enforced "$gate"; then
      printf '  БЛОК   %s\n' "$name"; blocked+="$name "
    else
      printf '  ! %s  (не блокирует: нет строки «%s» в .githooks/enforce)\n' "$name" "$gate"
      warned+="$name "
    fi
    # pytest заканчивает страницами предупреждений, и обычный tail хоронит те
    # две строки, где сказано что сломалось.
    if grep -qE '^(FAILED|ERROR)' "$out"; then
      grep -E '^(FAILED|ERROR)' "$out" | head -20 | sed 's/^/         /'
    else
      tail -15 "$out" | sed 's/^/         /'
    fi
  fi
  rm -f "$out"
}

echo "проверки перед отправкой (заменяют отключённый CI):"

# --- Стиль, типы, тесты --------------------------------------------------------
# Область не выдумываем. У большинства репозиториев исходники лежат в src/ и
# tests/, и линтовать сверх этого — значит ловить замечания в служебных
# скриптах, которые репозиторий намеренно не проверяет. Проверено 17.08 на
# openclaw-dev: `ruff check src/ tests/` — чисто, `ruff check .` — 36 замечаний.
lint_paths=()
[[ -d src ]] && lint_paths+=(src)
[[ -d tests ]] && lint_paths+=(tests)
[[ ${#lint_paths[@]} -eq 0 ]] && lint_paths=(.)

if [[ -f pyproject.toml ]]; then
  if command -v ruff >/dev/null 2>&1; then
    run lint "ruff check"  ruff check "${lint_paths[@]}"
    run lint "ruff format" ruff format --check "${lint_paths[@]}"
  else
    printf '  пропуск ruff не установлен (pip install ruff)\n'
  fi

  if grep -qE '^\[tool\.mypy\]' pyproject.toml 2>/dev/null || [[ -f mypy.ini ]]; then
    if command -v mypy >/dev/null 2>&1; then
      run types "mypy" mypy "${lint_paths[@]}"
    else
      printf '  пропуск mypy не установлен (pip install mypy)\n'
    fi
  fi
fi

[[ -x scripts/check_standard.py ]] && run lint "стандарт разработки" python scripts/check_standard.py

if [[ "${PREPUSH_SKIP_TESTS:-}" == "1" ]]; then
  printf '  пропуск тесты сняты через PREPUSH_SKIP_TESTS=1\n'
elif [[ -f pyproject.toml || -d tests ]]; then
  if command -v pytest >/dev/null 2>&1; then
    run tests "pytest" pytest -q
  else
    printf '  пропуск pytest не установлен\n'
  fi
fi

# --- Секреты: блокируют всегда -------------------------------------------------
# Отсутствие сканера отклоняет отправку, а не пропускает её: иначе ворота тихо
# становятся слабее той проверки CI, которую заменяют, ровно там, где это
# важнее всего. --redact держит саму находку вне терминала: хук, напечатавший
# пойманное значение, уже слил его в историю терминала и в запись экрана.
if ! command -v gitleaks >/dev/null 2>&1; then
  printf '  БЛОК   gitleaks не установлен — brew install gitleaks\n'
  blocked+="gitleaks "
else
  while IFS= read -r range; do
    [[ -z $range ]] && continue
    # shellcheck disable=SC2086
    run - "gitleaks ${range:0:24}" gitleaks git --no-banner --redact --exit-code 1 --log-opts="$range" .
  done <<<"$ranges"
fi

if [[ -n $blocked ]]; then
  printf '\nОтправка остановлена: %s\n' "$blocked"
  printf 'Почини, либо push --no-verify, если сознательно отправляешь непроверенное.\n'
  printf 'Долгие тесты и правка их не касается: PREPUSH_SKIP_TESTS=1 git push\n'
  exit 1
fi
if [[ -n $warned ]]; then
  printf '\nПроверки не пройдены, но не блокируют: %s\n' "$warned"
  printf 'Включить блокировку: добавь lint/types/tests в .githooks/enforce\n'
fi
echo "готово к отправке"
exit 0
